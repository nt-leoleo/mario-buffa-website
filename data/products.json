            {
                "svg": "assets/images/products/characteristics/security-verified.svg",
                "title": "Alta resistencia",
                "description": "Fabricados con materiales de alta calidad que soportan presión, desgaste y condiciones exigentes."
            },
            {
                "svg": "assets/images/products/characteristics/drop.svg",
